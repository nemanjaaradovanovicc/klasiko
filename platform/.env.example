NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_kljuc
SUPABASE_SERVICE_ROLE_KEY=service_role_kljuc
# Opciono. Dnevni posao (automatska zaduženja): Vercel ga šalje kao Bearer token. Dugačak slučajan niz. Bez njega zaduženja se prave dugmetom.
CRON_SECRET=dugacak_slucajan_niz
# Opciono, za kasnije: slanje mejlova preko Resend-a (podsetnici, reset lozinke, obaveštenja).
# Dok nisu upisani, aplikacija ne prikazuje funkcije koje traže mejl.
# RESEND_API_KEY=re_kljuc
# EMAIL_FROM=Klasiko <obavestenja@klasiko.rs>
# Opciono: kod sa telefona pri prijavi admina Klasika. Podrazumevano je isključeno.
# SUPERADMIN_MFA=on
